load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_binary", "dart_test")
load(":registry_contract.bzl", "check_registry_contract")
load(":unpinned_lock_contract.bzl", "check_unpinned_lock_contract")

exports_files(["pubspec.lock"])

# Asserts rules_dart's curated-registry resolver is loadable and usable from
# another module, the way rules_flutter consumes it.
check_registry_contract()

# Verifies that a lock entry without `sha256` fails with `lock_package_error`
# and `pub_lock_package_sha256_error`.
dart_test(
    name = "unpinned_lock_test",
    size = "small",
    defines = check_unpinned_lock_contract(),
    main = "unpinned_lock_test.dart",
)

# A package's non-`lib/` files are part of its runfiles. The test reads the
# generated spoke's own `pubspec.yaml`, which no compile action has seen, so it
# fails when the spoke stages `lib/` only.
dart_test(
    name = "package_files_test",
    size = "small",
    main = "package_files_test.dart",
    deps = [
        "@pub_deps//:collection",
        "@pub_deps//:file",
        "@rules_dart//dart/runfiles",
    ],
)

# `file` imports `path`, and `path` is declared with pub.package() above: both
# reach this binary through the one hub, so `file` must see the explicit repo.
dart_binary(
    name = "app",
    main = "main.dart",
    deps = [
        "@pub_deps//:collection",
        "@pub_deps//:file",
        "@pub_deps//:path",
    ],
)

# A `dart_binary` sees a transitive pub spoke's runtime files, not only the
# test runner.
dart_binary(
    name = "package_files_bin",
    main = "package_files_bin.dart",
    deps = [
        "@pub_deps//:file",
        "@rules_dart//dart/runfiles",
    ],
)

# The ruleset is named here rather than in `app`'s deps: a lint ruleset is not a
# dependency of the code it lints, and listing it there would carry it into the
# `DartInfo` of every downstream consumer.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
