load("//dart:defs.bzl", "dart_binary", "dart_code_asset")
load(
    "//dart/tests:cross_target_test.bzl",
    "arm64_jit_refusal_test",
    "armv7_abi_test",
    "armv7_flags_test",
    "armv7_jit_refusal_test",
    "native_has_no_target_flags_test",
    "riscv64_abi_test",
    "riscv64_flags_test",
    "riscv64_jit_refusal_test",
    "x64_jit_refusal_test",
    "x64_native_jit_success_test",
)

# Every Linux target rules_dart can cross-compile to, paired with the
# `@platforms//cpu` constraint that selects it. `linux_arm` is armv7 hardfloat:
# `@platforms//cpu:arm` is an alias for `aarch32` and would NOT match.
platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "linux_riscv64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:riscv64",
    ],
)

platform(
    name = "linux_arm",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:armv7",
    ],
)

config_setting(
    name = "is_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "is_linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

dart_binary(
    name = "app",
    main = "main.dart",
)

riscv64_flags_test(
    name = "riscv64_flags_test",
    size = "small",
    expected_target_arch = "riscv64",
    expected_target_os = "linux",
    target_under_test = ":app",
)

armv7_flags_test(
    name = "armv7_flags_test",
    size = "small",
    expected_target_arch = "arm",
    expected_target_os = "linux",
    target_under_test = ":app",
)

native_has_no_target_flags_test(
    name = "native_has_no_target_flags_test",
    size = "small",
    target_under_test = ":app",
)

dart_binary(
    name = "app_with_asserts",
    dart_compile_flags = ["--enable-asserts"],
    main = "main.dart",
    tags = ["manual"],
)

riscv64_flags_test(
    name = "riscv64_asserts_flags_test",
    size = "small",
    expected_flags = ["--enable-asserts"],
    expected_target_arch = "riscv64",
    expected_target_os = "linux",
    target_under_test = ":app_with_asserts",
)

dart_binary(
    name = "app_aot",
    compile_mode = "aot-snapshot",
    main = "main.dart",
    tags = ["manual"],
)

riscv64_flags_test(
    name = "riscv64_aot_flags_test",
    size = "small",
    expected_target_arch = "riscv64",
    expected_target_os = "linux",
    target_under_test = ":app_aot",
)

# A `dynamic_loading_system` asset names a library already present on the target
# and takes no `shared_library`, so nothing here needs a cc toolchain for
# riscv64/armv7 — which is what lets these tests reach `target_dart_abi`
# instead of dying in cc toolchain resolution first.
dart_code_asset(
    name = "system_asset",
    asset_id = "package:cross_fixture/src/ffi/cross.g.dart",
    link_mode = "dynamic_loading_system",
    system_uri = "libc.so.6",
)

dart_binary(
    name = "app_with_asset",
    code_assets = [":system_asset"],
    main = "main.dart",
)

riscv64_abi_test(
    name = "riscv64_abi_test",
    size = "small",
    expected_abi = "linux_riscv64",
    target_under_test = ":app_with_asset",
)

armv7_abi_test(
    name = "armv7_abi_test",
    size = "small",
    expected_abi = "linux_arm",
    target_under_test = ":app_with_asset",
)

dart_binary(
    name = "app_jit",
    compile_mode = "jit-snapshot",
    main = "main.dart",
    tags = ["manual"],
)

riscv64_jit_refusal_test(
    name = "riscv64_jit_refusal_test",
    size = "small",
    target_under_test = ":app_jit",
)

armv7_jit_refusal_test(
    name = "armv7_jit_refusal_test",
    size = "small",
    target_under_test = ":app_jit",
)

arm64_jit_refusal_test(
    name = "arm64_jit_refusal_test",
    size = "small",
    target_compatible_with = select({
        ":is_linux_arm64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    target_under_test = ":app_jit",
)

x64_jit_refusal_test(
    name = "x64_jit_refusal_test",
    size = "small",
    target_compatible_with = select({
        ":is_linux_x64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    target_under_test = ":app_jit",
)

x64_native_jit_success_test(
    name = "x64_native_jit_success_test",
    size = "small",
    target_compatible_with = select({
        ":is_linux_x64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    target_under_test = ":app_jit",
)
