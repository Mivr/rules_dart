load("//dart:defs.bzl", "dart_library")

# A library that imports `dart:ui` through the embedder, so it analyzes only from
# source. Its closure holds `sky_engine`, and the `dart_analyze` aspect must not
# check it against summaries.
dart_library(
    name = "flutter_app",
    package_name = "flutter_app",
    srcs = ["lib/app.dart"],
    language_version = "3.11",
    visibility = ["//dart/tests:__subpackages__"],
    deps = ["//dart/tests/analyzer_summary_fixture/flutter:sky_engine"],
)
