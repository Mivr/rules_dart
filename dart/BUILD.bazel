load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//dart/private:build_settings.bzl", "dart_defines_flag")
load("//dart/private:dart_sdk_binary.bzl", "dart_sdk_binary")
load("//dart/private:resolved_toolchain.bzl", "resolved_toolchain")

# Dart environment declarations folded into every Dart compile, after any
# target-level `defines`. Repeatable — one define per occurrence:
#   bazel build //app --@rules_dart//dart:extra_dart_defines=FOO=bar
dart_defines_flag(
    name = "extra_dart_defines",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)

# Whether `dart_test` runs under an app-JIT snapshot of the `package:test` runner,
# which starts each test faster than the runner's kernel does. The snapshot is
# trained for a baseline CPU rather than the build host's, which is meant to let a
# remote cache share it across CPUs. Turn the flag off when a snapshot misbehaves;
# each test then runs the runner's kernel, as before:
#   bazel test //... --@rules_dart//dart:test_runner_snapshot=false
bool_flag(
    name = "test_runner_snapshot",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# Whether `dart_analyze` checks each target against per-library summaries of its
# dependencies, rather than analyzing the dependencies' source again. It is
# faster, and a body edit in a library stops re-analyzing the libraries above it,
# since a summary holds no function bodies. Turn it on in `.bazelrc`:
#   common --@rules_dart//dart:analyzer_summaries=true
#
# The diagnostics come from rules_dart's pinned `package:analyzer`, 13.3.0, with
# the lint rules of the SDK linter vendored in //third_party/dart_linter (the
# commit that published that analyzer). On the CI red paths they matched
# `dart analyze` line for line. The vendored set lacks `migrate_design_widgets`
# relative to SDK 3.13.5. Once the SDK moves ahead of the pin, diagnostics can
# drift from the SDK's `dart analyze`. `dart fix` still runs on the SDK. The
# default is off, and that keeps each check exactly as `dart analyze` runs it.
bool_flag(
    name = "analyzer_summaries",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# This is the target rule authors should put in their "toolchains"
# attribute in order to get a runtime for the correct platform.
# See https://docs.bazel.build/versions/main/toolchains.html#writing-rules-that-use-toolchains
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# Build-time tools (the codegen rules) resolve their Dart SDK through this type
# instead of `:toolchain_type`. Codegen runs on the exec/host machine and emits
# platform-agnostic Dart source, so its toolchains are registered with
# `exec_compatible_with` pinned and `target_compatible_with` omitted — i.e.
# selection is independent of the build's target platform. This lets codegen
# resolve under any target platform (iOS, Android, …), including ones rules_dart
# registers no compile toolchain for.
toolchain_type(
    name = "exec_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

resolved_toolchain(
    name = "resolved_toolchain",
    # Marked manual so that `bazel test //...` passes
    # even if no toolchain is registered.
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Run the Dart SDK binary:
#   bazel run @rules_dart//dart -- --version
#   bazel run @rules_dart//dart -- analyze lib
dart_sdk_binary(
    name = "dart",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dart/private:toolchains_repo",
        "//dart/private:versions",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dart/private:dart_aggregate_codegen",
        "//dart/private:dart_analysis_options",
        "//dart/private:dart_analysis_test",
        "//dart/private:dart_analyze_aspect",
        "//dart/private:dart_binary",
        "//dart/private:dart_codegen",
        "//dart/private:dart_fix",
        "//dart/private:dart_format",
        "//dart/private:dart_library",
        "//dart/private:dart_link_hook",
        "//dart/private:dart_test",
        "//dart/private:dart_web_application",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":repositories",
        "//dart/private:toolchain_selection",
    ],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "utils",
    srcs = ["utils.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dart/private:common",
        "//dart/private:dart_info",
        "//dart/private:dart_library",
        "//dart/private:source_set",
    ],
)

# The `dart_analysis_config` whose options the `dart_analyze` aspect, `dart_fix`
# and `dart_format` use. The default lists none: every file gets the SDK's
# defaults.
label_flag(
    name = "analysis_config",
    build_setting_default = "//dart/private:empty_analysis_config",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "analyze",
    srcs = ["analyze.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart/private:dart_analyze_aspect"],
)
